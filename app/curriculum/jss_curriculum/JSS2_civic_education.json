  "description": "Junior Secondary School 2 Civic Education - Democracy, governance, citizenship rights",
  "waec_high_priority_topics": [],
  "topics": [
    {
      "title": "Democracy",
      "term": 1,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Democratic Principles",
          "concepts": [
            "Meaning of democracy",
            "Types of democracy",
            "Features of democracy",
            "Importance of democracy",
            "Challenges of democracy"
          ],
          "learning_objectives": [
            "Explain democratic principles",
            "Evaluate democratic practices"
          ],
          "common_misconceptions": [
            "Thinking democracy means no rules"
          ]
        }
      ]
    },
    {
      "title": "Government in Nigeria",
      "term": 1,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Structure of Government",
          "concepts": [
            "Three tiers of government",
            "Arms of government",
            "Separation of powers",
            "Checks and balances",
            "Constitution"
          ],
          "learning_objectives": [
            "Describe Nigeria's government structure",
            "Explain separation of powers"
          ],
          "common_misconceptions": [
            "Confusing executive with legislature"
          ]
        }
      ]
    },
    {
      "title": "Citizenship Rights",
      "term": 2,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Fundamental Rights",
          "concepts": [
            "Right to life",
            "Right to fair hearing",
            "Freedom of expression",
            "Freedom of movement",
            "Right to education"
          ],
          "learning_objectives": [
            "List fundamental rights",
            "Explain how rights can be limited"
          ],
          "common_misconceptions": [
            "Thinking rights are absolute"
          ]
        }
      ]
    },
    {
      "title": "Human Trafficking",
      "term": 2,
      "waec_frequency": "medium",
      "subtopics": [
        {
          "title": "Causes and Prevention",
          "concepts": [
            "Meaning of human trafficking",
            "Causes",
            "Effects",
            "Prevention strategies",
            "Laws against trafficking"
          ],
          "learning_objectives": [
            "Explain human trafficking",
            "Suggest prevention measures"
          ],
          "common_misconceptions": [
            "Thinking trafficking only involves kidnapping"
          ]
        }
      ]
    },
    {
      "title": "Drug Abuse",
      "term": 3,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Substance Abuse",
          "concepts": [
            "Types of drugs",
            "Drug abuse vs misuse",
            "Causes of drug abuse",
            "Effects of drug abuse",
            "Prevention and control"
          ],
          "learning_objectives": [
            "Identify commonly abused drugs",
            "Explain effects of drug abuse"
          ],
          "common_misconceptions": [
            "Thinking legal drugs cannot be abused"
          ]
        }
      ]
    },
    {
      "title": "Leadership",
      "term": 3,
      "waec_frequency": "medium",
      "subtopics": [
        {
          "title": "Leadership Skills",
          "concepts": [
            "Types of leadership",
            "Qualities of good leaders",
            "Followership",
            "Servant leadership",
            "Youth leadership"
          ],
          "learning_objectives": [
            "Describe qualities of good leaders",
            "Demonstrate leadership skills"
          ],
          "common_misconceptions": [
            "Thinking leadership is only for adults"
          ]
        }
      ]
    }
  ]
