  "description": "Junior Secondary School 2 Business Studies - Commerce, trade, bookkeeping, and entrepreneurship",
  "waec_high_priority_topics": [],
  "topics": [
    {
      "title": "Commerce",
      "term": 1,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Introduction to Commerce",
          "concepts": [
            "Meaning of commerce",
            "Trade and aids to trade",
            "Home trade",
            "Foreign trade",
            "Importance of commerce"
          ],
          "learning_objectives": [
            "Define commerce",
            "Distinguish trade from aids to trade"
          ],
          "common_misconceptions": [
            "Confusing commerce with business"
          ]
        }
      ]
    },
    {
      "title": "Aids to Trade",
      "term": 1,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Supporting Services",
          "concepts": [
            "Transportation",
            "Communication",
            "Banking",
            "Insurance",
            "Warehousing",
            "Advertising"
          ],
          "learning_objectives": [
            "Explain each aid to trade",
            "Describe their importance"
          ],
          "common_misconceptions": [
            "Thinking trade can exist without aids"
          ]
        }
      ]
    },
    {
      "title": "Book Keeping",
      "term": 2,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Double Entry System",
          "concepts": [
            "Principles of double entry",
            "Debit and credit",
            "Ledger accounts",
            "Trial balance",
            "Cash book"
          ],
          "learning_objectives": [
            "Apply double entry principles",
            "Prepare ledger accounts"
          ],
          "common_misconceptions": [
            "Confusing debit with credit",
            "Thinking trial balance confirms accuracy"
          ]
        }
      ]
    },
    {
      "title": "Market",
      "term": 2,
      "waec_frequency": "medium",
      "subtopics": [
        {
          "title": "Types and Functions",
          "concepts": [
            "Meaning of market",
            "Types of markets",
            "Market functions",
            "Price determination",
            "Market structures"
          ],
          "learning_objectives": [
            "Classify markets",
            "Explain price determination"
          ],
          "common_misconceptions": [
            "Thinking market is only a physical place"
          ]
        }
      ]
    },
    {
      "title": "Consumer Education",
      "term": 3,
      "waec_frequency": "medium",
      "subtopics": [
        {
          "title": "Consumer Rights and Responsibilities",
          "concepts": [
            "Rights of consumers",
            "Consumer responsibilities",
            "Consumer protection agencies",
            "Redress mechanisms"
          ],
          "learning_objectives": [
            "List consumer rights",
            "Explain how to seek redress"
          ],
          "common_misconceptions": [
            "Thinking consumers have no rights"
          ]
        }
      ]
    },
    {
      "title": "Keyboarding",
      "term": 3,
      "waec_frequency": "medium",
      "subtopics": [
        {
          "title": "Advanced Typing",
          "concepts": [
            "Speed development",
            "Accuracy",
            "Formatting documents",
            "Tables and lists"
          ],
          "learning_objectives": [
            "Type with improved speed and accuracy"
          ],
          "common_misconceptions": [
            "Sacrificing accuracy for speed"
          ]
        }
      ]
    }
  ]
}