{
  "subject_name": "Civic Education",
  "class_level": "JSS1",
  "exam_relevance": [
    "BECE",
    "Junior WAEC"
  ],
  "description": "Junior Secondary School 1 Civic Education - Citizenship, rights, responsibilities, and national values",
  "waec_high_priority_topics": [],
  "topics": [
    {
      "title": "Citizenship",
      "term": 1,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Meaning and Types of Citizenship",
          "concepts": [
            "Definition of citizenship",
            "Citizenship by birth",
            "Citizenship by registration",
            "Citizenship by naturalization",
            "Dual citizenship"
          ],
          "learning_objectives": [
            "Define citizenship and identify types",
            "Explain how Nigerian citizenship is acquired"
          ],
          "common_misconceptions": [
            "Thinking anyone born in Nigeria is automatically a citizen",
            "Confusing residence with citizenship"
          ]
        }
      ]
    },
    {
      "title": "Rights and Duties of Citizens",
      "term": 1,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Fundamental Human Rights",
          "concepts": [
            "Right to life",
            "Right to dignity",
            "Right to fair hearing",
            "Right to freedom of expression",
            "Right to freedom of movement",
            "Right to education"
          ],
          "learning_objectives": [
            "List fundamental human rights",
            "Explain importance of each right",
            "Identify when rights are violated"
          ],
          "common_misconceptions": [
            "Thinking rights have no limits",
            "Confusing rights with privileges"
          ]
        },
        {
          "title": "Duties and Obligations",
          "concepts": [
            "Obeying laws",
            "Paying taxes",
            "Voting",
            "Defending the nation",
            "Respecting others' rights"
          ],
          "learning_objectives": [
            "List duties of a citizen",
            "Explain relationship between rights and duties"
          ],
          "common_misconceptions": [
            "Thinking duties are optional",
            "Separating rights from responsibilities"
          ]
        }
      ]
    },
    {
      "title": "National Values",
      "term": 1,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Core Nigerian Values",
          "concepts": [
            "Integrity",
            "Discipline",
            "Self-reliance",
            "Patriotism",
            "Respect",
            "Honesty",
            "Tolerance"
          ],
          "learning_objectives": [
            "Define each national value",
            "Give examples of values in action",
            "Explain importance of values in society"
          ],
          "common_misconceptions": [
            "Thinking values are the same for everyone",
            "Confusing values with rules"
          ]
        }
      ]
    },
    {
      "title": "Government and Governance",
      "term": 2,
      "waec_frequency": "medium",
      "subtopics": [
        {
          "title": "Levels of Government",
          "concepts": [
            "Federal government",
            "State government",
            "Local government",
            "Functions of each level",
            "Relationship between levels"
          ],
          "learning_objectives": [
            "Identify three tiers of government",
            "List functions of each tier",
            "Explain separation of powers"
          ],
          "common_misconceptions": [
            "Thinking president controls everything",
            "Confusing state and federal responsibilities"
          ]
        }
      ]
    },
    {
      "title": "Democracy and Rule of Law",
      "term": 2,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Democratic Principles",
          "concepts": [
            "Meaning of democracy",
            "Features of democracy",
            "Importance of rule of law",
            "Electoral process",
            "Political parties"
          ],
          "learning_objectives": [
            "Explain meaning and features of democracy",
            "Describe electoral process in Nigeria",
            "Explain importance of rule of law"
          ],
          "common_misconceptions": [
            "Thinking democracy means majority always wins",
            "Confusing democracy with anarchy"
          ]
        }
      ]
    },
    {
      "title": "Social Issues",
      "term": 3,
      "waec_frequency": "medium",
      "subtopics": [
        {
          "title": "Contemporary Social Issues",
          "concepts": [
            "Corruption and its effects",
            "Drug abuse",
            "Cultism",
            "Human trafficking",
            "Child abuse",
            "HIV/AIDS awareness"
          ],
          "learning_objectives": [
            "Identify social problems in Nigeria",
            "Explain causes and effects",
            "Suggest solutions to social problems"
          ],
          "common_misconceptions": [
            "Thinking corruption only involves politicians",
            "Believing HIV can be cured"
          ]
        }
      ]
    },
    {
      "title": "Nationalism and Patriotism",
      "term": 3,
      "waec_frequency": "medium",
      "subtopics": [
        {
          "title": "Love for Country",
          "learning_objectives": [
            "Distinguish nationalism from patriotism",
            "Explain importance of national symbols",
            "Demonstrate patriotism in daily life"
          ],
          "common_misconceptions": [
            "Thinking patriotism means supporting government always",
            "Confusing nationalism with ethnic loyalty"
          ],
          "concepts": [
            "Meaning of nationalism",
            "Meaning of patriotism",
            "Symbols of national identity",
            "National anthem and pledge",
            "Ways to show patriotism"
          ]
        }
      ]
    }
  ]
}