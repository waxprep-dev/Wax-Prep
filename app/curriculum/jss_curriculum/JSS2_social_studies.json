{
  "subject_name": "Social Studies",
  "class_level": "JSS2",
  "exam_relevance": [
    "BECE",
    "Junior WAEC"
  ],
  "description": "Junior Secondary School 2 Social Studies - Nigerian history, geography, economy, and social issues",
  "waec_high_priority_topics": [],
  "topics": [
    {
      "title": "Nigerian History",
      "term": 1,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Pre-Colonial Nigeria",
          "concepts": [
            "Early Nigerian societies",
            "Hausa-Fulani empire",
            "Yoruba kingdoms",
            "Igbo societies",
            "Benin kingdom",
            "Trans-Saharan trade"
          ],
          "learning_objectives": [
            "Describe pre-colonial Nigerian societies",
            "Explain their political systems"
          ],
          "common_misconceptions": [
            "Thinking Nigeria existed before colonialism"
          ]
        }
      ]
    },
    {
      "title": "Colonial Rule",
      "term": 1,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "British Colonial Administration",
          "concepts": [
            "Reasons for colonization",
            "Methods of colonial rule",
            "Indirect rule",
            "Effects of colonialism",
            "Nationalist movements"
          ],
          "learning_objectives": [
            "Explain colonial administration",
            "Evaluate effects of colonialism"
          ],
          "common_misconceptions": [
            "Thinking colonialism was entirely negative"
          ]
        }
      ]
    },
    {
      "title": "Nigerian Economy",
      "term": 2,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Economic Systems",
          "concepts": [
            "Types of economic systems",
            "Agriculture",
            "Mineral resources",
            "Oil and gas",
            "Trade and commerce"
          ],
          "learning_objectives": [
            "Describe Nigeria's economic structure",
            "Identify major economic sectors"
          ],
          "common_misconceptions": [
            "Thinking oil is Nigeria's only resource"
          ]
        }
      ]
    },
    {
      "title": "Geography of Nigeria",
      "term": 2,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Physical Features",
          "concepts": [
            "Location and size",
            "Climate zones",
            "Vegetation belts",
            "Rivers and lakes",
            "Population distribution"
          ],
          "learning_objectives": [
            "Describe Nigeria's physical geography",
            "Explain climate patterns"
          ],
          "common_misconceptions": [
            "Thinking all of Nigeria is hot"
          ]
        }
      ]
    },
    {
      "title": "Social Problems",
      "term": 3,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Contemporary Issues",
          "concepts": [
            "Poverty",
            "Unemployment",
            "Corruption",
            "Ethnic conflicts",
            "Religious conflicts"
          ],
          "learning_objectives": [
            "Identify social problems",
            "Suggest solutions"
          ],
          "common_misconceptions": [
            "Blaming government for all problems"
          ]
        }
      ]
    },
    {
      "title": "Globalization",
      "term": 3,
      "waec_frequency": "medium",
      "subtopics": [
        {
          "title": "Global Interconnectedness",
          "concepts": [
            "Meaning of globalization",
            "Advantages",
            "Disadvantages",
            "Effects on Nigeria",
            "Preserving culture"
          ],
          "learning_objectives": [
            "Explain globalization",
            "Evaluate its impact"
          ],
          "common_misconceptions": [
            "Thinking globalization is only about technology"
          ]
        }
      ]
    }
  ]
}