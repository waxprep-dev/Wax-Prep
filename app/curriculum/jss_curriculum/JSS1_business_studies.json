            "Confusing entrepreneur with manager"
          ]
        }
      ]
    },
    {
      "title": "Book Keeping",
      "term": 3,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Introduction to Book Keeping",
          "concepts": [
