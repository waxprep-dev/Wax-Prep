  "description": "Junior Secondary School 1 Business Studies - Introduction to business, trade, and entrepreneurship",
  "waec_high_priority_topics": [],
  "topics": [
    {
      "title": "Introduction to Business",
      "term": 1,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Meaning and Importance",
          "concepts": [
            "Definition of business",
            "Why people engage in business",
            "Types of business activities",
            "Importance of business to society"
          ],
          "learning_objectives": [
            "Define business",
            "Give reasons why people do business"
          ],
          "common_misconceptions": [
            "Thinking business is only about money",
            "Confusing business with employment"
          ]
        }
      ]
    },
    {
      "title": "The Office",
      "term": 1,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Office Functions and Types",
          "concepts": [
            "Meaning of an office",
            "Types of office",
            "Functions of an office",
            "Office equipment",
            "Office layout"
          ],
          "learning_objectives": [
            "Describe types of offices",
            "List office functions and equipment"
          ],
          "common_misconceptions": [
            "Thinking offices must have computers",
            "Confusing front office with back office"
          ]
        }
      ]
    },
    {
      "title": "Occupations",
      "term": 2,
      "waec_frequency": "medium",
      "subtopics": [
        {
          "title": "Types of Occupations",
