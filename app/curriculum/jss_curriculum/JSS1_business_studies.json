          ],
          "learning_objectives": [
            "Classify occupations into groups",
            "Explain factors in choosing a career"
          ],
          "common_misconceptions": [
            "Thinking white collar jobs are better",
            "Confusing profession with occupation"
          ]
        }
      ]
    },
    {
      "title": "Production",
      "term": 2,
      "waec_frequency": "medium",
      "subtopics": [
        {
          "title": "Factors and Types of Production",
          "concepts": [
