{
  "subject_name": "Mathematics",
  "class_level": "SS1",
  "exam_relevance": [
    "WAEC",
    "NECO",
    "JAMB"
  ],
  "description": "Senior Secondary School 1 Mathematics - Algebra, geometry, trigonometry, statistics foundation",
  "waec_high_priority_topics": [
    "Quadratic Equations",
    "Simultaneous Equations",
    "Trigonometry",
    "Mensuration",
    "Statistics"
  ],
  "topics": [
    {
      "title": "Number Systems",
      "term": 1,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Real Numbers and Surds",
          "concepts": [
            "Rational numbers",
            "Irrational numbers",
            "Surds",
            "Surd operations",
            "Rationalization of denominators"
          ],
          "learning_objectives": [
            "Simplify and rationalize surds"
          ],
          "common_misconceptions": [
            "Thinking surds can be added directly",
            "Confusing sqrt(a+b) with sqrt(a)+sqrt(b)"
          ]
        }
      ]
    },
    {
      "title": "Sets",
      "term": 1,
      "waec_frequency": "medium",
      "subtopics": [
        {
          "title": "Set Theory",
          "concepts": [
            "Set notation",
            "Types of sets (finite, infinite, universal, null, subset)",
            "Set operations (union, intersection, complement)",
            "Venn diagrams (up to 3 sets)",
            "Applications"
          ],
          "learning_objectives": [
            "Solve problems using Venn diagrams"
          ],
          "common_misconceptions": [
            "Confusing union with intersection",
            "Counting elements in overlap twice"
          ]
        }
      ]
    },
    {
      "title": "Algebraic Expressions",
      "term": 1,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Expansion and Factorization",
          "concepts": [
            "Expansion of brackets",
            "Factorization by grouping",
            "Factorization of quadratics",
            "Difference of two squares",
            "Algebraic fractions"
          ],
          "learning_objectives": [
            "Factorize complex expressions",
            "Simplify algebraic fractions"
          ],
          "common_misconceptions": [
            "Sign errors in expansion",
            "Incomplete factorization"
          ]
        }
      ]
    },
    {
      "title": "Equations",
      "term": 1,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Linear and Quadratic Equations",
          "concepts": [
            "Linear equations",
            "Simultaneous equations (substitution, elimination)",
            "Quadratic equations (factorization, formula, completing square)",
            "Word problems"
          ],
          "learning_objectives": [
            "Solve all types of equations"
          ],
          "common_misconceptions": [
            "Forgetting \u00b1 in quadratic formula",
            "Wrong substitution in elimination"
          ]
        }
      ]
    },
    {
      "title": "Indices and Logarithms",
      "term": 2,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Laws and Applications",
          "concepts": [
            "Laws of indices",
            "Negative and fractional indices",
            "Laws of logarithms",
            "Change of base formula",
            "Logarithmic equations"
          ],
          "learning_objectives": [
            "Apply all laws of indices and logs"
          ],
          "common_misconceptions": [
            "log(a+b) != log(a)+log(b)",
            "a^0 = 1 not 0"
          ]
        }
      ]
    },
    {
      "title": "Sequences and Series",
      "term": 2,
      "waec_frequency": "medium",
      "subtopics": [
        {
          "title": "AP and GP",
          "concepts": [
            "Arithmetic progression (nth term, sum)",
            "Geometric progression (nth term, sum to infinity)",
            "Real-life applications"
          ],
          "learning_objectives": [
            "Find nth term and sum of AP/GP"
          ],
          "common_misconceptions": [
            "Confusing AP with GP formulas"
          ]
        }
      ]
    },
    {
      "title": "Geometry",
      "term": 2,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Plane Geometry",
          "concepts": [
            "Angles (parallel lines, polygons)",
            "Triangle properties",
            "Congruence and similarity",
            "Pythagoras theorem",
            "Loci"
          ],
          "learning_objectives": [
            "Prove congruence/similarity",
            "Calculate angles in polygons"
          ],
          "common_misconceptions": [
            "AAA is similarity not congruence",
            "All rhombuses are squares"
          ]
        }
      ]
    },
    {
      "title": "Trigonometry",
      "term": 2,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Basic Trigonometry",
          "concepts": [
            "Trig ratios (sin, cos, tan)",
            "Special angles",
            "Angles of elevation/depression",
            "Bearings",
            "Sine and cosine rules"
          ],
          "learning_objectives": [
            "Solve trig problems including bearings"
          ],
          "common_misconceptions": [
            "Confusing sine rule with cosine rule",
            "Wrong special angle values"
          ]
        }
      ]
    },
    {
      "title": "Mensuration",
      "term": 3,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Areas and Volumes",
          "concepts": [
            "Area of sectors and segments",
            "Surface area (cone, sphere, cylinder)",
            "Volume (cone, sphere, frustum)",
            "Composite shapes"
          ],
          "learning_objectives": [
            "Calculate surface areas and volumes"
          ],
          "common_misconceptions": [
            "Using diameter instead of radius",
            "Slant height vs perpendicular height"
          ]
        }
      ]
    },
    {
      "title": "Statistics",
      "term": 3,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Data Analysis",
          "concepts": [
            "Frequency distribution",
            "Mean, median, mode",
            "Range, mean deviation, standard deviation",
            "Quartiles, percentiles",
            "Histograms and ogives"
          ],
          "learning_objectives": [
            "Calculate all measures of location and dispersion"
          ],
          "common_misconceptions": [
            "Confusing mean with median",
            "Not ordering data for median"
          ]
        }
      ]
    },
    {
      "title": "Probability",
      "term": 3,
      "waec_frequency": "medium",
      "subtopics": [
        {
          "title": "Basic Probability",
          "concepts": [
            "Sample space",
            "Mutually exclusive events",
            "Independent events",
            "Tree diagrams",
            "Conditional probability"
          ],
          "learning_objectives": [
            "Calculate probability of combined events"
          ],
          "common_misconceptions": [
            "Gambler's fallacy",
            "Adding non-mutually exclusive probabilities"
          ]
        }
      ]
    }
  ]
}