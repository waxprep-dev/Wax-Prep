          ],
          "common_misconceptions": [
            "Shares and debentures are same"
          ]
        }
      ]
    },
    {
      "title": "Ratio Analysis",
      "term": 1,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Accounting Ratios",
          "concepts": [
            "Profitability ratios",
            "Liquidity ratios",
            "Efficiency ratios",
            "Investment ratios",
            "Interpretation"
          ],
          "learning_objectives": [
