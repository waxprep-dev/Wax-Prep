          ],
          "common_misconceptions": [
            "High ratio is always good"
          ]
        }
      ]
    },
    {
      "title": "Departmental Accounts",
      "term": 1,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Department Accounting",
          "concepts": [
            "Meaning",
            "Preparation",
