{
  "subject_name": "Financial Accounting",
  "class_level": "SS2",
  "exam_relevance": [
    "WAEC",
    "NECO",
    "JAMB"
  ],
  "description": "SS2 Financial Accounting - Company accounts, ratio analysis, departmental accounts, public sector accounting",
  "waec_high_priority_topics": [
    "Company Accounts",
    "Ratio Analysis",
    "Departmental Accounts",
    "Public Sector Accounting"
  ],
  "topics": [
