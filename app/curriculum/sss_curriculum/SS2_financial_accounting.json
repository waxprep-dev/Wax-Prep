      "term": 1,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Limited Companies",
          "concepts": [
            "Formation",
            "Share capital",
            "Debentures",
            "Final accounts",
            "Appropriation account"
          ],
          "learning_objectives": [
