{
  "subject_name": "Civic Education",
  "class_level": "SS2",
  "exam_relevance": [
    "WAEC",
    "NECO"
  ],
  "description": "SS2 Civic Education - Human rights, citizenship, government, Nigerian constitution",
  "waec_high_priority_topics": [
    "Human Rights",
    "Citizenship",
    "Government",
    "Constitution"
  ],
  "topics": [
