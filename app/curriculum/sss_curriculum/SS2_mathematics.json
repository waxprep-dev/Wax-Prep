{
  "subject_name": "Mathematics",
  "class_level": "SS2",
  "exam_relevance": [
    "WAEC",
    "NECO",
    "JAMB"
  ],
  "description": "Senior Secondary School 2 Mathematics - Advanced algebra, calculus, coordinate geometry, vectors",
  "waec_high_priority_topics": [
    "Differentiation",
    "Integration",
    "Circle Geometry",
    "Coordinate Geometry",
    "Vectors"
  ],
  "topics": [
    {
      "title": "Logarithms and Surds",
      "term": 1,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Advanced Calculations",
          "concepts": [
            "Laws of logarithms",
            "Change of base",
            "Logarithmic equations",
            "Surd operations",
            "Rationalization"
          ],
          "learning_objectives": [
            "Solve complex log and surd problems"
          ],
          "common_misconceptions": [
            "log(a+b) = log(a) + log(b)"
          ]
        }
      ]
    },
    {
      "title": "Polynomials",
      "term": 1,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Polynomial Functions",
          "concepts": [
            "Division of polynomials",
            "Factor theorem",
            "Remainder theorem",
            "Roots of polynomials"
          ],
          "learning_objectives": [
            "Apply factor and remainder theorems"
          ],
          "common_misconceptions": [
            "Factor theorem only works for linear factors"
          ]
        }
      ]
    },
    {
      "title": "Inequalities",
      "term": 1,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Linear and Quadratic",
          "concepts": [
            "Linear inequalities",
            "Quadratic inequalities",
            "Range of values",
            "Modulus inequalities"
          ],
          "learning_objectives": [
            "Solve inequality problems"
          ],
          "common_misconceptions": [
            "Multiplying inequality by negative keeps sign"
          ]
        }
      ]
    },
    {
      "title": "Coordinate Geometry",
      "term": 1,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Straight Lines and Curves",
          "concepts": [
            "Gradient and intercept",
            "Equation of lines",
            "Distance between points",
            "Midpoint",
            "Parallel and perpendicular lines"
          ],
          "learning_objectives": [
            "Solve coordinate geometry problems"
          ],
          "common_misconceptions": [
            "Gradient of perpendicular is same"
          ]
        }
      ]
    },
    {
      "title": "Circle Geometry",
      "term": 2,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Properties of Circles",
          "concepts": [
            "Equation of circle",
            "Tangents and normals",
            "Chords",
            "Angles in alternate segment",
            "Cyclic quadrilaterals"
          ],
          "learning_objectives": [
            "Apply circle theorems"
          ],
          "common_misconceptions": [
            "All angles in semicircle are 60 degrees"
          ]
        }
      ]
    },
    {
      "title": "Differentiation",
      "term": 2,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Differential Calculus",
          "concepts": [
            "Limit definition",
            "Power rule",
            "Product and quotient rules",
            "Chain rule",
            "Applications (max/min, rates of change)"
          ],
          "learning_objectives": [
            "Differentiate complex functions"
          ],
          "common_misconceptions": [
            "d(uv) = du * dv"
          ]
        }
      ]
    },
    {
      "title": "Integration",
      "term": 2,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Integral Calculus",
          "concepts": [
            "Indefinite integrals",
            "Definite integrals",
            "Integration by substitution",
            "Area under curves"
          ],
          "learning_objectives": [
            "Evaluate integrals"
          ],
          "common_misconceptions": [
            "Forgetting constant of integration"
          ]
        }
      ]
    },
    {
      "title": "Vectors",
      "term": 3,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Vector Algebra",
          "concepts": [
            "Vector representation",
            "Addition and subtraction",
            "Scalar multiplication",
            "Scalar product",
            "Vector product"
          ],
          "learning_objectives": [
            "Perform vector operations"
          ],
          "common_misconceptions": [
            "Vector product is same as scalar product"
          ]
        }
      ]
    },
    {
      "title": "Statistics",
      "term": 3,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Advanced Statistics",
          "concepts": [
            "Probability",
            "Permutations and combinations",
            "Binomial distribution",
            "Normal distribution"
          ],
          "learning_objectives": [
            "Solve probability problems"
          ],
          "common_misconceptions": [
            "Probability cannot be calculated exactly"
          ]
        }
      ]
    },
    {
      "title": "Mechanics",
      "term": 3,
      "waec_frequency": "medium",
      "subtopics": [
        {
          "title": "Simple Applications",
          "concepts": [
            "Forces",
            "Moments",
            "Equilibrium",
            "Projectiles"
          ],
          "learning_objectives": [
            "Solve mechanics problems"
          ],
          "common_misconceptions": [
            "Equilibrium means no forces"
          ]
        }
      ]
    }
  ]
