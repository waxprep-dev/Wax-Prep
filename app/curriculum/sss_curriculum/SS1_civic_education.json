{
  "subject_name": "Civic Education",
  "class_level": "SS1",
  "exam_relevance": [
    "WAEC",
    "NECO",
    "JAMB"
  ],
  "description": "Senior Secondary School 1 Civic Education - Citizenship, rights, government, national values",
  "waec_high_priority_topics": [
    "Citizenship",
    "Human Rights",
    "Democracy",
    "National Values"
  ],
  "topics": [
    {
      "title": "Citizenship",
      "term": 1,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Meaning and Types",
          "concepts": [
            "Definition",
            "Citizenship by birth",
            "Citizenship by registration",
            "Citizenship by naturalization",
            "Dual citizenship"
          ],
          "learning_objectives": [
            "Explain types of citizenship"
          ],
          "common_misconceptions": [
            "Anyone born in Nigeria is citizen"
          ]
        }
      ]
    },
    {
      "title": "Rights and Obligations",
      "term": 1,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Fundamental Rights",
          "concepts": [
            "Rights in Nigerian constitution",
            "Human rights",
            "Duties of citizens",
            "Limitations on rights"
          ],
          "learning_objectives": [
            "List fundamental rights"
          ],
          "common_misconceptions": [
            "Rights are absolute"
          ]
        }
      ]
    },
    {
      "title": "Nationalism and Patriotism",
      "term": 1,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Love for Country",
          "concepts": [
            "Meaning of nationalism",
            "Meaning of patriotism",
            "Ways to show patriotism",
            "National symbols"
          ],
          "learning_objectives": [
            "Demonstrate patriotism"
          ],
          "common_misconceptions": [
            "Patriotism means supporting government always"
          ]
        }
      ]
    },
    {
      "title": "Democracy",
      "term": 2,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Democratic Principles",
          "concepts": [
            "Meaning",
            "Features",
            "Types",
            "Electoral process",
            "Political parties"
          ],
          "learning_objectives": [
            "Explain democratic features"
          ],
          "common_misconceptions": [
            "Democracy means majority always wins"
          ]
        }
      ]
    },
    {
      "title": "Government",
      "term": 2,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Nigerian Government",
          "concepts": [
            "Federal system",
            "Separation of powers",
            "Constitution",
            "Arms of government"
          ],
          "learning_objectives": [
            "Describe government structure"
          ],
          "common_misconceptions": [
            "President controls everything"
          ]
        }
      ]
    },
    {
      "title": "Rule of Law",
      "term": 2,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Legal Framework",
          "concepts": [
            "Meaning",
            "Principles",
            "Supremacy of constitution",
            "Equality before law"
          ],
          "learning_objectives": [
            "Explain rule of law"
          ],
          "common_misconceptions": [
            "Rule of law means many laws"
          ]
        }
      ]
    },
    {
      "title": "National Values",
      "term": 3,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Core Values",
          "concepts": [
            "Integrity",
            "Discipline",
            "Self-reliance",
            "Patriotism",
            "Respect"
          ],
          "learning_objectives": [
            "Apply national values"
          ],
          "common_misconceptions": [
            "Values are the same for everyone"
          ]
        }
      ]
    },
    {
      "title": "Social Issues",
      "term": 3,
      "waec_frequency": "high",
      "subtopics": [
        {
          "title": "Contemporary Problems",
          "concepts": [
            "Corruption",
            "Drug abuse",
            "Cultism",
            "Human trafficking",
            "Youth empowerment"
          ],
          "learning_objectives": [
            "Suggest solutions"
          ],
          "common_misconceptions": [
            "Government alone should fix problems"
          ]
        }
      ]
    },
    {
      "title": "Leadership",
      "term": 3,
      "waec_frequency": "medium",
      "subtopics": [
        {
          "title": "Leadership Skills",
          "concepts": [
            "Types",
            "Qualities of good leaders",
            "Followership",
            "Servant leadership"
          ],
          "learning_objectives": [
            "Demonstrate leadership"
          ],
          "common_misconceptions": [
            "Leadership is only for adults"
          ]
        }
      ]
    },
    {
      "title": "International Organizations",
      "term": 3,
      "waec_frequency": "medium",
      "subtopics": [
        {
          "title": "Global Cooperation",
          "concepts": [
            "UN",
            "AU",
            "ECOWAS",
            "Commonwealth",
            "Nigeria's role"
          ],
          "learning_objectives": [
            "Explain roles of international bodies"
          ],
          "common_misconceptions": [
