# Render (Deployment)
RENDER_API_KEY=rnd_nRj5ALGRnR5VVTQvDY6WMPBYH3hy
RENDER_SERVICE_ID=srv-d7t1dcugkk3c73dqkleg

# GitHub (Version Control)
GITHUB_TOKEN=ghp_your_github_token
