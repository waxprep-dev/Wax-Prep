# WhatsApp (Session Config)
WA_SESSION_NAME=david-os-session
WA_QR_TIMEOUT=60000
WA_RESTART_ON_AUTH_FAIL=true

# Personality Engine
CONFIDENCE_THRESHOLD=0.7
MAX_CONTEXT_MESSAGES=20
CONVERSATION_SUMMARY_THRESHOLD=50
TYPING_DELAY_MIN=1000
TYPING_DELAY_MAX=8000
NEGOTIATION_BUDGET_THRESHOLD=50000

# Time & Location
TIMEZONE=Africa/Lagos
QUIET_HOURS_START=00:00
QUIET_HOURS_END=06:00
COUNTRY_CODE=NG

# Features
AI_ENABLED=true
VOICE_TRANSCRIPTION_ENABLED=true
IMAGE_ANALYSIS_ENABLED=true
COST_TRACKING_ENABLED=true
AUTO_ARCHIVE_DAYS=90
MAX_MESSAGE_LENGTH=500
GHOST_MODE_DEFAULT=false

# Monitoring
LOG_LEVEL=info
HEALTH_CHECK_INTERVAL=30000
METRICS_RETENTION_DAYS=30
ALERT_EMAIL=
ALERT_WEBHOOK_URL=

# External Integrations (Optional)
GOOGLE_CALENDAR_API_KEY=
SLACK_WEBHOOK_URL=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
